{
  "name": "tomkyle-webapp-boilerplate",
  "author": "Carsten Witt <tomkyle@posteo.de>",
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.26",
    "@babel/preset-env": "^7.26",
    "@exampledev/new.css": "^1.1",
    "@lhci/cli": "^0.14",
    "@materializecss/materialize": "~2.2.2",
    "apache-server-configs": "^6.0.0",
    "babel-loader": "^10.0",
    "bootstrap": "^5.3.5",
    "chokidar-cli": "^3.0.0",
    "css-loader": "^7.1",
    "cssnano": "^7.0",
    "exports-loader": "^5.0",
    "getenv": "^1.0.0",
    "gulp": "^5.0",
    "gulp-autoprefixer": "^9.0",
    "gulp-jshint": "^2.1",
    "gulp-postcss": "^10.0",
    "gulp-replace": "^1.1.4",
    "gulp-sass": "^6.0.1",
    "gulp-sourcemaps": "^3.0",
    "gulp-terser": "^2.1.0",
    "imagemagick": "^0.1.3",
    "imports-loader": "^5.0",
    "jshint": "^2.13",
    "jshint-stylish": "^2.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.86",
    "sass-loader": "^16.0",
    "style-loader": "^4.0",
    "svgexport": "^0.4",
    "terser-webpack-plugin": "^5.3",
    "webpack-cli": "^6.0",
    "webpack-stream": "^7.0",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-cli": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-navigation-preload": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-recipes": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-webpack-plugin": "^7.3.0",
    "workbox-window": "^7.3.0"
  },
  "scripts": {
    "dev": "npx gulp && npx workbox-cli injectManifest",
    "build": "NODE_ENV=production npx gulp && NODE_ENV=production npx workbox-cli injectManifest",

    "lighthouse": "npm-run-all -s build lighthouse:*",
    "lighthouse:run": "npx lhci autorun --config lighthouserc.js",

    "watch": "npm-run-all -p watch:*",

    "watch:tests":     "chokidar \"tests/**/*.php\"     -c \"npm run phpunit:short {path} && npm run rector {path}\"",
    "watch:src":       "chokidar \"src/**/*.php\"       -c \"vendor/bin/frt {path} && npm run phpstan {path} && npm run rector {path}\"",
    "watch:resources": "chokidar \"core/**/*.php\"      -c \"npm run phpunit:integration\"",

    "rector": "./vendor/bin/rector process --dry-run",
    "rector:apply": "./vendor/bin/rector process",

    "phpcs"       : "./vendor/bin/php-cs-fixer fix --verbose --diff --dry-run",
    "phpcs:apply" : "./vendor/bin/php-cs-fixer fix --verbose --diff",

    "phpstan":             "./vendor/bin/phpstan --no-progress analyse",

    "phpunit":             "./vendor/bin/phpunit",
    "phpunit:short":       "npm run phpunit -- --no-coverage",
    "phpunit:unit":        "npm run phpunit -- --testsuite unit",
    "phpunit:integration": "npm run phpunit -- --testsuite integration",
    "phpunit:functional":  "npm run phpunit -- --testsuite functional"
  }
}
